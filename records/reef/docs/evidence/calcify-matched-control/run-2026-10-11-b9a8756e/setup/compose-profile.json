{
  "services": {
    "platform-api": {
      "image": "reef-platform-runtime:calcify-contention-20261011",
      "environment": {
        "PLATFORM_SETTLEMENT_FACTS_ENABLED": "false",
        "RUNTIME_POSTGRES_JDBC_URL": "",
        "RUNTIME_PROJECTION_POSTGRES_JDBC_URL": "",
        "RUNTIME_PERSISTENCE": "noop",
        "EXTERNAL_API_IDEMPOTENCY_STORE": "inmemory",
        "EXTERNAL_API_COMMAND_CAPTURE_MODE": "disabled",
        "EXTERNAL_API_COMMAND_LOG_MODE": "disabled",
        "EXTERNAL_API_COMMAND_PROCESSING_MODE": "stream-ack",
        "EXTERNAL_API_ABUSE_BREAKER_MODE": "off",
        "STREAM_ACK_INTAKE_STORE": "inmemory",
        "STREAM_ACK_INMEMORY_INTAKE_MAX_ENTRIES": "100000",
        "STREAM_ACK_INMEMORY_INTAKE_SHARDS": "256",
        "PLATFORM_HTTP_SERVER": "netty",
        "PLATFORM_INTERNAL_HTTP_MODE": "enabled",
        "STREAM_ACK_LOG_PROVIDER": "redpanda",
        "STREAM_ACK_PARTITION_COUNT": "16",
        "STREAM_ACK_COMMAND_STREAM": "REEF_CONTENTION-CTRL-01_COMMANDS",
        "STREAM_ACK_SUBJECT_PREFIX": "reef.contention-ctrl-01.cmd.v1",
        "STREAM_ACK_PUBLISH_PIPELINE_ENABLED": "true",
        "STREAM_ACK_PUBLISH_PIPELINE_QUEUE_CAPACITY": "8192",
        "STREAM_ACK_PUBLISH_PIPELINE_MAX_IN_FLIGHT_PER_LANE": "256",
        "STREAM_ACK_PUBLISH_PIPELINE_BATCH_SIZE": "1",
        "STREAM_ACK_PUBLISH_PIPELINE_BATCH_LINGER_MS": "0",
        "STREAM_ACK_WORKER_ENABLED": "false",
        "STREAM_ACK_PROJECTOR_ENABLED": "false",
        "ORDER_LIFECYCLE_PROJECTOR_ENABLED": "false",
        "MARKET_DATA_PROJECTOR_ENABLED": "false",
        "VENUE_EVENT_MATERIALIZER_ENABLED": "false",
        "STREAM_INGRESS_ENABLED": "false",
        "STREAM_ACK_BACKPRESSURE_WORKER_DURABLES": "reef-engine-direct-p00,reef-engine-direct-p01,reef-engine-direct-p02,reef-engine-direct-p03,reef-engine-direct-p04,reef-engine-direct-p05,reef-engine-direct-p06,reef-engine-direct-p07,reef-engine-direct-p08,reef-engine-direct-p09,reef-engine-direct-p10,reef-engine-direct-p11,reef-engine-direct-p12,reef-engine-direct-p13,reef-engine-direct-p14,reef-engine-direct-p15",
        "JAVA_TOOL_OPTIONS": "-Xms128m -Xmx512m -XX:ActiveProcessorCount=2"
      },
      "container_name": "reef-calcify-contention-20261011-platform-api",
      "labels": {
        "reef.proof": "reef-calcify-contention-20261011"
      }
    },
    "matching-engine": {
      "image": "reef-matching-engine:calcify-contention-20261011",
      "environment": {
        "STREAM_ACK_LOG_PROVIDER": "redpanda",
        "STREAM_ACK_KAFKA_BOOTSTRAP_SERVERS": "redpanda:9092",
        "STREAM_ACK_PARTITION_COUNT": "16",
        "STREAM_ACK_COMMAND_STREAM": "REEF_CONTENTION-CTRL-01_COMMANDS",
        "STREAM_ACK_SUBJECT_PREFIX": "reef.contention-ctrl-01.cmd.v1",
        "MATCHING_ENGINE_DIRECT_STREAM_ENABLED": "true",
        "MATCHING_ENGINE_DIRECT_STREAM_PARTITIONS": "0..15",
        "MATCHING_ENGINE_DIRECT_STREAM_BATCH_SIZE": "500",
        "MATCHING_ENGINE_DIRECT_STREAM_FETCH_TIMEOUT_MS": "100",
        "MATCHING_ENGINE_DIRECT_STREAM_POLL_MS": "1",
        "MATCHING_ENGINE_DIRECT_STREAM_MAX_ACK_PENDING": "16000",
        "MATCHING_ENGINE_DIRECT_STREAM_ACK_WAIT_MS": "60000",
        "MATCHING_ENGINE_TERMINAL_ORDER_RETENTION_LIMIT": "0",
        "MATCHING_ENGINE_EVENT_STREAM": "REEF_CONTENTION-CTRL-01_EVENTS",
        "MATCHING_ENGINE_EVENT_SUBJECT_PREFIX": "reef.contention-ctrl-01.events.v1",
        "MATCHING_ENGINE_KAFKA_MAX_MESSAGE_BYTES": "4194304",
        "MATCHING_ENGINE_KAFKA_COMPRESSION_TYPE": "none"
      },
      "container_name": "reef-calcify-contention-20261011-matching-engine",
      "labels": {
        "reef.proof": "reef-calcify-contention-20261011"
      }
    },
    "calcify-extractor": {
      "image": "reef-platform-runtime:calcify-contention-20261011",
      "environment": {
        "STREAM_ACK_KAFKA_BOOTSTRAP_SERVERS": "redpanda:9092",
        "RUNTIME_POSTGRES_JDBC_URL": "jdbc:postgresql://postgres:5432/reef?currentSchema=runtime",
        "RUNTIME_POSTGRES_USER": "reef",
        "RUNTIME_POSTGRES_PASSWORD": "reef",
        "CALCIFY_SOURCE_TOPIC": "REEF_CONTENTION-CTRL-01_EVENTS",
        "CALCIFY_COMMITMENT_TOPIC": "REEF_CONTENTION-CTRL-01_COMMITMENTS",
        "CALCIFY_VERIFIED_TOPIC": "REEF_CONTENTION-CTRL-01_VERIFIED",
        "CALCIFY_SOURCE_GENERATION": "5",
        "CALCIFY_BROKER_KIND": "REDPANDA",
        "CALCIFY_INTERNAL_TOPIC_REPLICATION_FACTOR": "1",
        "JAVA_TOOL_OPTIONS": "-Xms128m -Xmx1g -XX:ActiveProcessorCount=2"
      },
      "container_name": "reef-calcify-contention-20261011-calcify-extractor",
      "labels": {
        "reef.proof": "reef-calcify-contention-20261011"
      }
    },
    "calcify-verifier": {
      "image": "reef-platform-runtime:calcify-contention-20261011",
      "environment": {
        "STREAM_ACK_KAFKA_BOOTSTRAP_SERVERS": "redpanda:9092",
        "RUNTIME_POSTGRES_JDBC_URL": "jdbc:postgresql://postgres:5432/reef?currentSchema=runtime",
        "RUNTIME_POSTGRES_USER": "reef",
        "RUNTIME_POSTGRES_PASSWORD": "reef",
        "CALCIFY_SOURCE_TOPIC": "REEF_CONTENTION-CTRL-01_EVENTS",
        "CALCIFY_COMMITMENT_TOPIC": "REEF_CONTENTION-CTRL-01_COMMITMENTS",
        "CALCIFY_VERIFIED_TOPIC": "REEF_CONTENTION-CTRL-01_VERIFIED",
        "CALCIFY_SOURCE_GENERATION": "5",
        "CALCIFY_BROKER_KIND": "REDPANDA",
        "CALCIFY_INTERNAL_TOPIC_REPLICATION_FACTOR": "1",
        "JAVA_TOOL_OPTIONS": "-Xms128m -Xmx1g -XX:ActiveProcessorCount=2",
        "CALCIFY_VERIFIER_MAX_POLL_RECORDS": "1000"
      },
      "container_name": "reef-calcify-contention-20261011-calcify-verifier",
      "labels": {
        "reef.proof": "reef-calcify-contention-20261011"
      }
    },
    "calcify-resolver": {
      "image": "reef-platform-runtime:calcify-contention-20261011",
      "environment": {
        "STREAM_ACK_KAFKA_BOOTSTRAP_SERVERS": "redpanda:9092",
        "RUNTIME_POSTGRES_JDBC_URL": "jdbc:postgresql://postgres:5432/reef?currentSchema=runtime",
        "RUNTIME_POSTGRES_USER": "reef",
        "RUNTIME_POSTGRES_PASSWORD": "reef",
        "CALCIFY_SOURCE_TOPIC": "REEF_CONTENTION-CTRL-01_EVENTS",
        "CALCIFY_COMMITMENT_TOPIC": "REEF_CONTENTION-CTRL-01_COMMITMENTS",
        "CALCIFY_VERIFIED_TOPIC": "REEF_CONTENTION-CTRL-01_VERIFIED",
        "CALCIFY_SOURCE_GENERATION": "5",
        "CALCIFY_BROKER_KIND": "REDPANDA",
        "CALCIFY_INTERNAL_TOPIC_REPLICATION_FACTOR": "1",
        "JAVA_TOOL_OPTIONS": "-Xms128m -Xmx1g -XX:ActiveProcessorCount=2",
        "CALCIFY_RESOLVED_TOPIC": "REEF_CONTENTION-CTRL-01_RESOLVED",
        "CALCIFY_RESOLVER_APPLICATION_ID": "reef-contention-ctrl-01-g5",
        "CALCIFY_RESOLVER_THREADS": "2",
        "CALCIFY_RESOLVER_STANDBYS": "0",
        "CALCIFY_RESOLVER_MAX_PENDING": "1000"
      },
      "container_name": "reef-calcify-contention-20261011-calcify-resolver",
      "labels": {
        "reef.proof": "reef-calcify-contention-20261011"
      }
    },
    "postgres": {
      "container_name": "reef-calcify-contention-20261011-postgres",
      "labels": {
        "reef.proof": "reef-calcify-contention-20261011"
      }
    },
    "redpanda": {
      "container_name": "reef-calcify-contention-20261011-redpanda",
      "labels": {
        "reef.proof": "reef-calcify-contention-20261011"
      },
      "image": "redpandadata/redpanda:v26.2.3"
    }
  },
  "networks": {
    "default": {
      "ipam": {
        "config": [
          {
            "subnet": "10.252.200.0/24"
          }
        ]
      }
    }
  }
}