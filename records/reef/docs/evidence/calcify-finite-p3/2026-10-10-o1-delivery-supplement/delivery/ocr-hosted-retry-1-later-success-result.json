  "comments": [
    {
      "path": "services/matching-engine/internal/streamdirect/processor.go",
      "content": "`ProcessOnce` now fails fast when lifecycle mode is enabled, but `NewProcessor` is still used directly in tests and other package-internal call sites without going through `StartRunner`. That means a caller can construct a processor with `CalcifyLifecycleEnabled=true` and only discover the fatal config error on the first fetch path, which is a different contract from the runner-level gate and makes the mode easy to partially enable in code paths that expect `NewProcessor` to be usable immediately. Consider moving this validation into `NewProcessor` or making the constructor return an error so invalid lifecycle settings cannot escape initialization.",
      "suggestion_code": "func NewProcessor(service *app.Service, source CommandSource, publisher EventBatchPublisher, config ProcessorConfig) (*Processor, error) {\n\t// ... existing setup ...\n\tlifecycleError := validateCalcifyLifecycle(service, config.CalcifyLifecycleEnabled, config.CalcifyFiniteBindingDigest, config.BatchSize)\n\tif lifecycleError != nil {\n\t\treturn nil, lifecycleError\n\t}\n\tprocessor := &Processor{ /* ... */ }\n\tif config.CalcifyLifecycleEnabled {\n\t\tprocessor.lifecycleProfileHash = service.CalcifySourceProfileHash()\n\t}\n\treturn processor, nil\n}",
      "existing_code": "func (p *Processor) ProcessOnce(ctx context.Context) (int, error) {\n\tif p.lifecycleError != nil {\n\t\treturn 0, &fatalProcessorError{cause: p.lifecycleError}\n\t}",
      "start_line": 257,
      "end_line": 260,
      "category": "bug",
      "severity": "medium"
    },
    {
      "path": "services/matching-engine/internal/streamdirect/config.go",
      "content": "`validateCalcifyLifecycle` only checks that the provided binding digest is well-formed; it never verifies that it matches the service's actual source profile hash. As written, any lowercase 64-char hex string will pass validation, and the processor will later emit lifecycle facts with a potentially unrelated `FiniteBindingDigest`, defeating the binding guarantee this mode is supposed to enforce.",
      "suggestion_code": "func validateCalcifyLifecycle(service *app.Service, enabled bool, binding string, batchSize int) error {\n\tif !enabled {\n\t\treturn nil\n\t}\n\tdecoded, err := hex.DecodeString(binding)\n\tif err != nil || len(decoded) != 32 || len(binding) != 64 || binding != strings.ToLower(binding) {\n\t\treturn fmt.Errorf(\"Calcify lifecycle requires lowercase SHA256 finite binding digest\")\n\t}\n\tif service == nil || service.CalcifySourceProfileHash() == \"\" {\n\t\treturn fmt.Errorf(\"Calcify lifecycle requires finite source profile\")\n\t}\n\tif err := service.ValidateCalcifySourceProfile(); err != nil {\n\t\treturn err\n\t}\n\tif binding != service.CalcifySourceProfileHash() {\n\t\treturn fmt.Errorf(\"Calcify lifecycle finite binding digest does not match source profile\")\n\t}\n\tif batchSize != 1 {\n\t\treturn fmt.Errorf(\"Calcify lifecycle requires batch size 1\")\n\t}\n\treturn nil\n}",
      "existing_code": "func validateCalcifyLifecycle(service *app.Service, enabled bool, binding string, batchSize int) error {\n\tif !enabled {\n\t\treturn nil\n\t}\n\tdecoded, err := hex.DecodeString(binding)\n\tif err != nil || len(decoded) != 32 || len(binding) != 64 || binding != strings.ToLower(binding) {\n\t\treturn fmt.Errorf(\"Calcify lifecycle requires lowercase SHA256 finite binding digest\")\n\t}\n\tif service == nil || service.CalcifySourceProfileHash() == \"\" {\n\t\treturn fmt.Errorf(\"Calcify lifecycle requires finite source profile\")\n\t}\n\tif err := service.ValidateCalcifySourceProfile(); err != nil {\n\t\treturn err\n\t}\n\tif batchSize != 1 {\n\t\treturn fmt.Errorf(\"Calcify lifecycle requires batch size 1\")\n\t}\n\treturn nil\n}",
      "start_line": 79,
      "end_line": 97,
      "category": "bug",
      "severity": "high"
    }
  ],
