+                    .setSourceOrderType(orderType).setQuantityUnits(required(fields,"quantityUnits")).setLimitPrice(required(fields,"limitPrice"))
+                    .setCurrency(binding.currency).setTimeInForce(TimeInForce.TIME_IN_FORCE_DAY))
