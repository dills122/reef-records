+            "cancel" -> { require(fields.fieldNames() == setOf("reason")); builder.setKind(LifecycleCommandKindV1.LIFECYCLE_COMMAND_CANCEL).setCancel(LifecycleCancelV1.newBuilder().setReason(optional(fields,"reason"))) }
